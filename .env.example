# ============================================================
# Asa Fabric — consultation / sample-request email configuration
# Copy to .env.local for local dev, or set these as Environment
# Variables in the Vercel project. All are read at request time by
# the /api/consultation serverless function — no rebuild needed.
# ============================================================

# Which provider sends the emails: resend | sendgrid | ses | console
# Leave unset (or "console") to log instead of send — the form still
# works end-to-end without any secrets.
EMAIL_PROVIDER=console

# Verified sender shown in the From: header.
EMAIL_FROM="Asa Fabric <hello@asafabric.com>"

# Internal inbox(es) that receive new-submission notifications.
# Comma-separated for more than one recipient.
EMAIL_TO="sales@asafabric.com"

# ---- Resend (https://resend.com) ----
# EMAIL_PROVIDER=resend
RESEND_API_KEY=

# ---- SendGrid (https://sendgrid.com) ----
# EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# ---- AWS SES (https://aws.amazon.com/ses) ----
# EMAIL_PROVIDER=ses
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # only for temporary STS credentials
